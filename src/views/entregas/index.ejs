<% const statusOpcoes = ['CRIADA', 'EM_TRANSITO', 'ENTREGUE', 'CANCELADA']; %>

<h1>Entregas</h1>

<p><a href="/entregas/nova">Nova Entrega</a></p>

<form method="GET" action="/entregas">
  <label for="status">Status</label>
  <select name="status" id="status">
    <option value="">Todos</option>
    <% statusOpcoes.forEach(s => { %>
      <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
    <% }); %>
  </select>
  <button type="submit">Filtrar</button>
</form>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Descrição</th>
      <th>Origem</th>
      <th>Destino</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% if (entregas.length === 0) { %>
      <tr><td colspan="5">Nenhuma entrega encontrada.</td></tr>
    <% } %>
    <% entregas.forEach(e => { %>
      <tr>
        <td><a href="/entregas/<%= e.id %>"><%= e.id %></a></td>
        <td><%= e.descricao %></td>
        <td><%= e.origem %></td>
        <td><%= e.destino %></td>
        <td><span class="badge badge-<%= e.status.toLowerCase() %>"><%= e.status %></span></td>
      </tr>
    <% }); %>
  </tbody>
</table>
