<h1>Novo Motorista</h1>

<% if (erros.length > 0) { %>
  <div class="alert alert-error">
    <ul>
      <% erros.forEach(erro => { %><li><%= erro %></li><% }); %>
    </ul>
  </div>
<% } %>

<form method="POST" action="/motoristas" novalidate>
  <div>
    <label for="nome">Nome</label>
    <input type="text" id="nome" name="nome" value="<%= dados.nome || '' %>">
  </div>

  <div>
    <label for="cpf">CPF</label>
    <input type="text" id="cpf" name="cpf" value="<%= dados.cpf || '' %>">
  </div>

  <button type="submit">Cadastrar motorista</button>
  <a href="/motoristas">Voltar</a>
</form>
