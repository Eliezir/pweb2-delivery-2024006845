<h1>Motoristas</h1>

<p><a href="/motoristas/novo">Novo Motorista</a></p>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>CPF</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% if (motoristas.length === 0) { %>
      <tr><td colspan="4">Nenhum motorista cadastrado.</td></tr>
    <% } %>
    <% motoristas.forEach(m => { %>
      <tr>
        <td><%= m.id %></td>
        <td><%= m.nome %></td>
        <td><%= m.cpf %></td>
        <td><%= m.status %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
